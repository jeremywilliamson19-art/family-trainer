{
  "name": "family-trainer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc -b && tsc -p backend",
    "test": "vitest run",
    "icons": "pwa-assets-generator",
    "backend:build": "node backend/build.mjs",
    "backend:push": "node backend/build.mjs && clasp push --force",
    "backend:deploy": "node backend/build.mjs && clasp push --force && node backend/deploy.mjs",
    "deploy:web": "./deploy-web.sh",
    "dev:api": "esbuild backend/dev-server.ts --bundle --platform=node --format=esm --outfile=backend/dist/dev-server.mjs --log-level=warning && node backend/dist/dev-server.mjs"
  },
  "dependencies": {
    "@zxing/library": "^0.23.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1"
  },
  "devDependencies": {
    "@google/clasp": "^3.4.1",
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@types/google-apps-script": "^2.0.13",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "http_ece": "^1.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
